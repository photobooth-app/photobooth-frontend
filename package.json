    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@jsonforms/core": "^3.8.0",
    "@jsonforms/vue": "^3.8.0",
    "@quasar/extras": "^2.1.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "pinia": "^4.1.0",
    "qrcode.vue": "^3.11.1",
    "quasar": "^2.35.6",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@quasar/app-vite": "^3.10.4",
    "@types/lodash": "^4.17.27",
    "autoprefixer": "^10.7.0",
    "globals": "^17.14.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
